# Research Assistant Agent - Environment Variables
# Copy this file to .env and fill in your API keys
# 
# Command to create .env from this file:
#   cp env.example .env
# Then edit .env and add your API key

# Required when LLM_BACKEND=perplexity (the default)
# Get a key from: https://www.perplexity.ai/
PERPLEXITY_API_KEY=your-perplexity-api-key-here

# Optional page-by-page PDF vision (handwriting, diagrams, charts, scanned text)
# Add an image-capable provider key or use an Ollama vision model.
# VISION_PROVIDER=auto
# VISION_MODEL=gpt-4o-mini
# OPENAI_API_KEY=your-openai-api-key-here
# GEMINI_API_KEY=your-gemini-api-key-here
# For local processing, set VISION_PROVIDER=ollama and VISION_MODEL to an
# image-capable model installed in Ollama.

# Optional: Hugging Face API Token
# Only needed if you want to use HF Inference API for embeddings
# Otherwise, the system uses local sentence-transformers (recommended)
# HUGGINGFACE_API_TOKEN=your-hf-token-here
